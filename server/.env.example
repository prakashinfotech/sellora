# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sellora
DB_USER=postgres
DB_PASS=yourpassword

# JWT Configuration
JWT_SECRET=your_jwt_secret

# SMTP Configuration (for OTP password-reset emails)
